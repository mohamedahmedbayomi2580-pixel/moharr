{
  "name": "my-ui-builder",
  "version": "1.0.0",
  "description": "My UI Builder - visual UI editor",
  "author": "My UI Builder",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/test.js",
    "build:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/cli": "^6.1.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.myuibuilder.app",
    "productName": "My UI Builder",
    "files": ["main.js", "www/**/*"],
    "directories": { "output": "dist" },
    "win": { "target": ["nsis", "portable"] }
  }
}
